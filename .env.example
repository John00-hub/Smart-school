# ============================================================================
# SMARTSCHOOL — ENVIRONMENT
# ============================================================================
# Copy this file to `.env` and fill in the two values from your Supabase
# project:  Dashboard > Project Settings > API
#
#   VITE_SUPABASE_URL       Project URL           https://xxxx.supabase.co
#   VITE_SUPABASE_ANON_KEY  anon / public key     (long JWT starting with eyJ)
#
# While these are unset the app runs in DEMO MODE on local data.
# Set them, restart `npm run dev`, and every screen reads/writes the real DB.
#
# NEVER put the service_role key here. That key bypasses Row Level Security
# and would let any visitor read or write every record. It belongs only in
# server-side scripts or CI, and is not used anywhere in this project.
# ============================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
