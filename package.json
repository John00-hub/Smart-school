{
  "name": "smartschool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "esbuild test/smoke.ts --bundle --format=esm --outfile=test/smoke.mjs --platform=browser --external:@supabase/supabase-js --define:import.meta.env='{}' && node test/run-smoke.mjs",
    "check:sql": "node validate_sql.cjs supabase/schema.sql && node validate_sql.cjs supabase/seed.sql && node check_policies.cjs supabase/schema.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "autoprefixer": "^10.6.1",
    "lucide-react": "^1.59.0",
    "postcss": "^8.5.31",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "libpg-query": "^18.1.5",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
